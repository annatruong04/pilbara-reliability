/// Generated by src/step5_generate_dax.py on 2026-09-10
/// Coefficients from analysis_model_results.csv, model M2 distance weighted, n=137

table _Measures

	/// Regression coefficient on proximity-weighted severity. Source: analysis_model_results.csv, model M2 distance weighted, n=137
	measure 'Severity Coefficient' =
			-1.6620
		formatString: 0.0000
		displayFolder: 00 Constants

	/// Lower bound of the 95% confidence interval.
	measure 'Severity CI Low' =
			-2.4148
		formatString: 0.0000
		displayFolder: 00 Constants

	/// Upper bound of the 95% confidence interval.
	measure 'Severity CI High' =
			-0.9091
		formatString: 0.0000
		displayFolder: 00 Constants

	/// Exchange rate assumption, used only to express tonnes as dollars.
	measure 'AUD per USD' =
			0.65
		formatString: 0.00
		displayFolder: 00 Constants

	/// Distance scale for the severity weighting. An assumption.
	measure 'Proximity Decay Km' =
			200
		formatString: 0
		displayFolder: 00 Constants

	/// Illustrative benchmark. Not sourced from Pilbara Ports.
	measure 'Availability Target' =
			0.98
		formatString: 0.0%
		displayFolder: 00 Constants

	/// Estimated production-equivalent lost days across cyclone events.
	measure 'Total Downtime Days' =
			SUM ( fact_reliability_event[event_downtime_days] )
		formatString: #,0.0
		displayFolder: 01 Reliability

	/// Downtime expressed in hours.
	measure 'Total Downtime Hours' =
			SUM ( fact_reliability_event[event_downtime_hours] )
		formatString: #,0
		displayFolder: 01 Reliability

	/// Estimated production lost to cyclone events, million tonnes.
	measure 'Total Lost Mt' =
			SUM ( fact_reliability_event[event_lost_mt] )
		formatString: #,0.0
		displayFolder: 01 Reliability

	/// Number of cyclone events in context.
	measure 'Event Count' =
			COUNTROWS ( fact_reliability_event )
		formatString: #,0
		displayFolder: 01 Reliability

	/// Category 3 and above events.
	measure 'Severe Event Count' =
			CALCULATE ( [Event Count], fact_reliability_event[category] >= 3 )
		formatString: #,0
		displayFolder: 01 Reliability

	/// Observation window in years.
	measure 'Observation Years' =
			DIVIDE ( DISTINCTCOUNT ( fact_reliability_monthly[month] ), 12 )
		formatString: #,0.0
		displayFolder: 01 Reliability

	/// Annualised downtime.
	measure 'Downtime Days Per Year' =
			DIVIDE ( [Total Downtime Days], [Observation Years] )
		formatString: #,0.0
		displayFolder: 01 Reliability

	/// Annualised production loss.
	measure 'Lost Mt Per Year' =
			DIVIDE ( [Total Lost Mt], [Observation Years] )
		formatString: #,0.0
		displayFolder: 01 Reliability

	/// Mean monthly availability against modelled no-cyclone capability.
	measure 'Availability Pct' =
			AVERAGE ( fact_reliability_monthly[availability] )
		formatString: 0.00%
		displayFolder: 01 Reliability

	/// Availability restricted to months with a cyclone. Headline figure.
	measure 'Weather Availability Pct' =
			CALCULATE ( [Availability Pct], fact_reliability_monthly[weighted_severity] > 0 )
		formatString: 0.00%
		displayFolder: 01 Reliability

	/// Availability across the whole period. Higher than the weather-month figure because the denominator differs. Show it as supporting text, not as a second headline, or readers will assume an error.
	measure 'Overall Weather Availability' =
			1 - DIVIDE ( [Total Downtime Days], [Observation Years] * 365.25 )
		formatString: 0.00%
		displayFolder: 01 Reliability

	/// Months falling short of the target.
	measure 'Months Below Target' =
			CALCULATE ( COUNTROWS ( fact_reliability_monthly ), fact_reliability_monthly[availability] < [Availability Target] )
		formatString: #,0
		displayFolder: 01 Reliability

	/// Mean days between consecutive events, all severities. Pulled down by tropical lows, so pair it with the severe-only figure.
	measure 'MTBF Days' =
			AVERAGE ( fact_reliability_event[days_since_previous] )
		formatString: #,0
		displayFolder: 02 MTBF and MTTR

	/// MTBF expressed in years.
	measure 'MTBF Years' =
			DIVIDE ( [MTBF Days], 365.25 )
		formatString: #,0.00
		displayFolder: 02 MTBF and MTTR

	/// MTBF for Category 3 and above only. The planning-relevant figure.
	measure 'MTBF Severe Days' =
			VAR Severe =
			    FILTER (
			        ALLSELECTED ( fact_reliability_event ),
			        fact_reliability_event[category] >= 3
			    )
			VAR N = COUNTROWS ( Severe )
			VAR FirstDate = MINX ( Severe, fact_reliability_event[peak_datetime] )
			VAR LastDate = MAXX ( Severe, fact_reliability_event[peak_datetime] )
			RETURN
			    IF ( N > 1, DIVIDE ( DATEDIFF ( FirstDate, LastDate, DAY ), N - 1 ) )
		formatString: #,0
		displayFolder: 02 MTBF and MTTR

	/// Mean days to restore normal throughput. Inferred from monthly tonnage, not a measured repair duration.
	measure 'MTTR Days' =
			AVERAGE ( fact_reliability_event[event_downtime_days] )
		formatString: #,0.00
		displayFolder: 02 MTBF and MTTR

	/// MTTR for Category 3 and above.
	measure 'MTTR Severe Days' =
			CALCULATE ( [MTTR Days], fact_reliability_event[category] >= 3 )
		formatString: #,0.00
		displayFolder: 02 MTBF and MTTR

	/// MTTR for Category 4 and above.
	measure 'MTTR Cat4 Plus Days' =
			CALCULATE ( [MTTR Days], fact_reliability_event[category] >= 4 )
		formatString: #,0.00
		displayFolder: 02 MTBF and MTTR

	/// Rank of each category by total downtime.
	measure 'Downtime Rank' =
			RANKX (
			    ALLSELECTED ( fact_reliability_event[category_label] ),
			    [Total Downtime Days],
			    ,
			    DESC
			)
		formatString: #,0
		displayFolder: 03 Pareto

	/// Running total for the Pareto line.
	measure 'Cumulative Downtime Days' =
			VAR CurrentRank = [Downtime Rank]
			RETURN
			    SUMX (
			        FILTER (
			            ALLSELECTED ( fact_reliability_event[category_label] ),
			            [Downtime Rank] <= CurrentRank
			        ),
			        [Total Downtime Days]
			    )
		formatString: #,0.0
		displayFolder: 03 Pareto

	/// Cumulative percentage for the Pareto line.
	measure 'Cumulative Downtime Pct' =
			DIVIDE (
			    [Cumulative Downtime Days],
			    CALCULATE (
			        [Total Downtime Days],
			        ALLSELECTED ( fact_reliability_event[category_label] )
			    )
			)
		formatString: 0.0%
		displayFolder: 03 Pareto

	/// Share of all downtime from Category 3 and above.
	measure 'Severe Share of Downtime' =
			DIVIDE (
			    CALCULATE ( [Total Downtime Days], fact_reliability_event[category] >= 3 ),
			    CALCULATE ( [Total Downtime Days], ALL ( fact_reliability_event[category] ) )
			)
		formatString: 0.0%
		displayFolder: 03 Pareto

	/// Share of events that are severe. Contrast with the downtime share to show the Pareto effect.
	measure 'Severe Share of Events' =
			DIVIDE (
			    [Severe Event Count],
			    CALCULATE ( [Event Count], ALL ( fact_reliability_event[category] ) )
			)
		formatString: 0.0%
		displayFolder: 03 Pareto

	/// One-line summary for a card.
	measure 'Pareto Statement' =
			"Category 3 and above: " & FORMAT ( [Severe Share of Events], "0%" )
			    & " of events, " & FORMAT ( [Severe Share of Downtime], "0%" )
			    & " of downtime"
		displayFolder: 03 Pareto

	/// Category weighted by proximity, matching the regression input.
	measure 'Scenario Weighted Severity' =
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
			VAR Km = SELECTEDVALUE ( 'Scenario Distance'[Km], 100 )
			RETURN
			    Cat * EXP ( - DIVIDE ( Km, [Proximity Decay Km] ) )
		formatString: #,0.00
		displayFolder: 04 Scenario

	/// Central estimate of production lost.
	measure 'Expected Loss Mt' =
			ABS ( [Severity Coefficient] ) * [Scenario Weighted Severity]
		formatString: #,0.0
		displayFolder: 04 Scenario

	/// Lower bound. Never display without this.
	measure 'Expected Loss Low Mt' =
			ABS ( [Severity CI High] ) * [Scenario Weighted Severity]
		formatString: #,0.0
		displayFolder: 04 Scenario

	/// Upper bound. Never display without this.
	measure 'Expected Loss High Mt' =
			ABS ( [Severity CI Low] ) * [Scenario Weighted Severity]
		formatString: #,0.0
		displayFolder: 04 Scenario

	/// Mean daily throughput capability, converts tonnes to days.
	measure 'Daily Capability Mt' =
			AVERAGE ( fact_reliability_monthly[daily_capability_mt] )
		formatString: #,0.00
		displayFolder: 04 Scenario

	/// Loss as days of normal throughput.
	measure 'Expected Downtime Days' =
			DIVIDE ( [Expected Loss Mt], [Daily Capability Mt] )
		formatString: #,0.0
		displayFolder: 04 Scenario

	/// Deferred shipment value. Price and exchange rate are assumptions.
	measure 'Value At Risk AUD' =
			VAR PriceUSD = SELECTEDVALUE ( 'Iron Ore Price'[USD per tonne], 100 )
			RETURN
			    [Expected Loss Mt] * 1000000 * PriceUSD / [AUD per USD]
		formatString: \$#,0;(\$#,0)
		displayFolder: 04 Scenario

	/// Card text. Keeps the range attached to the central estimate.
	measure 'Loss Statement' =
			"Estimated " & FORMAT ( [Expected Loss Mt], "0.0" ) & " Mt lost, range "
			    & FORMAT ( [Expected Loss Low Mt], "0.0" ) & " to "
			    & FORMAT ( [Expected Loss High Mt], "0.0" ) & " Mt. About "
			    & FORMAT ( [Expected Downtime Days], "0.0" ) & " days of throughput."
		displayFolder: 04 Scenario

	/// Closest historical event to the scenario. Operators trust a named past event more than a modelled number.
	measure 'Nearest Analogue' =
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
			VAR Km = SELECTEDVALUE ( 'Scenario Distance'[Km], 100 )
			VAR Ranked =
			    ADDCOLUMNS (
			        ALL ( fact_reliability_event ),
			        "@dist",
			            ABS ( fact_reliability_event[category] - Cat ) * 100
			                + ABS ( fact_reliability_event[km_to_port_hedland] - Km )
			    )
			VAR Best = TOPN ( 1, Ranked, [@dist], ASC )
			RETURN
			    CONCATENATEX ( Best, fact_reliability_event[event_label] )
		displayFolder: 04 Scenario

	/// What the nearest analogue actually cost. Sits beside the modelled estimate as a reality check.
	measure 'Analogue Actual Loss Mt' =
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
			VAR Km = SELECTEDVALUE ( 'Scenario Distance'[Km], 100 )
			VAR Ranked =
			    ADDCOLUMNS (
			        ALL ( fact_reliability_event ),
			        "@dist",
			            ABS ( fact_reliability_event[category] - Cat ) * 100
			                + ABS ( fact_reliability_event[km_to_port_hedland] - Km )
			    )
			VAR Best = TOPN ( 1, Ranked, [@dist], ASC )
			RETURN
			    MAXX ( Best, fact_reliability_event[event_lost_mt] )
		formatString: #,0.00
		displayFolder: 04 Scenario

	/// Cost of stopping early. Derived from measured throughput.
	measure 'Production Forgone AUD' =
			VAR t = SELECTEDVALUE ( 'Lead Hours'[Hours] )
			VAR PriceUSD = SELECTEDVALUE ( 'Iron Ore Price'[USD per tonne], 100 )
			RETURN
			    t * DIVIDE ( [Daily Capability Mt], 24 ) * 1000000 * PriceUSD
			        / [AUD per USD]
		formatString: \$#,0
		displayFolder: 05 Shutdown timing

	/// ASSUMPTION, not fitted. No operator publishes incident-level damage outcomes. Structured so a fitted curve can replace it.
	measure 'Damage Probability' =
			VAR t = SELECTEDVALUE ( 'Lead Hours'[Hours] )
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
			VAR Mult = SELECTEDVALUE ( 'Curve Sensitivity'[Multiplier], 1 )
			VAR k = DIVIDE ( 0.06, MAX ( Cat, 1 ) ) * Mult
			VAR mid = 12 * Cat
			RETURN
			    DIVIDE ( 1, 1 + EXP ( k * ( t - mid ) ) )
		formatString: 0.0%
		displayFolder: 05 Shutdown timing

	/// Damage cost per category is an assumption, stated on the page.
	measure 'Expected Damage Cost AUD' =
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
			VAR DamageCostPerCat = 50000000
			RETURN
			    [Damage Probability] * DamageCostPerCat * Cat
		formatString: \$#,0
		displayFolder: 05 Shutdown timing

	/// The curve to minimise.
	measure 'Total Expected Cost AUD' =
			[Production Forgone AUD] + [Expected Damage Cost AUD]
		formatString: \$#,0
		displayFolder: 05 Shutdown timing

	/// Minimum safe evacuation window. A hard constraint, not a cost. Below this the option does not exist at any price.
	measure 'WHS Minimum Hours' =
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
			RETURN
			    IF ( Cat >= 3, 72, 48 )
		formatString: #,0
		displayFolder: 05 Shutdown timing

	/// Total cost, blanked inside the forbidden window.
	measure 'Cost Within WHS Limit' =
			IF (
			    SELECTEDVALUE ( 'Lead Hours'[Hours] ) >= [WHS Minimum Hours],
			    [Total Expected Cost AUD]
			)
		formatString: \$#,0
		displayFolder: 05 Shutdown timing

	/// Lowest-cost lead time inside the safe window.
	measure 'Optimal Lead Hours' =
			VAR Costs =
			    ADDCOLUMNS (
			        FILTER ( ALL ( 'Lead Hours' ), 'Lead Hours'[Hours] >= [WHS Minimum Hours] ),
			        "@cost", [Total Expected Cost AUD]
			    )
			VAR Best = TOPN ( 1, Costs, [@cost], ASC )
			RETURN
			    MAXX ( Best, 'Lead Hours'[Hours] )
		formatString: #,0
		displayFolder: 05 Shutdown timing

	/// Card text for the recommendation.
	measure 'Optimal Statement' =
			"Recommended shutdown: " & FORMAT ( [Optimal Lead Hours], "0" )
			    & " hours before landfall. WH&S minimum is "
			    & FORMAT ( [WHS Minimum Hours], "0" ) & " hours."
		displayFolder: 05 Shutdown timing

	/// Observed throughput.
	measure 'Actual Mt' =
			SUM ( fact_reliability_monthly[total_throughput_mt] )
		formatString: #,0.0
		displayFolder: 06 Validation

	/// Model prediction with observed severity.
	measure 'Fitted Mt' =
			SUM ( fact_reliability_monthly[fitted_mt] )
		formatString: #,0.0
		displayFolder: 06 Validation

	/// Model prediction with severity set to zero.
	measure 'Capability Mt' =
			SUM ( fact_reliability_monthly[capability_mt] )
		formatString: #,0.0
		displayFolder: 06 Validation

	/// Capability minus fitted. Not capability minus actual: the gap between actual and fitted is ordinary model residual.
	measure 'Modelled Loss Mt' =
			SUM ( fact_reliability_monthly[lost_mt] )
		formatString: #,0.0
		displayFolder: 06 Validation

	/// Model error, unrelated to cyclones.
	measure 'Residual Mt' =
			[Actual Mt] - [Fitted Mt]
		formatString: #,0.0
		displayFolder: 06 Validation

	/// Average absolute model error.
	measure 'Mean Absolute Error Mt' =
			AVERAGEX (
			    fact_reliability_monthly,
			    ABS (
			        fact_reliability_monthly[total_throughput_mt]
			            - fact_reliability_monthly[fitted_mt]
			    )
			)
		formatString: #,0.00
		displayFolder: 06 Validation

	/// Loss converted to days. The model never sees closure durations, so agreement with observed practice is external corroboration.
	measure 'Implied Closure Days' =
			DIVIDE ( [Total Lost Mt], [Daily Capability Mt] )
		formatString: #,0.0
		displayFolder: 06 Validation

	/// Years between events of at least the selected severity and proximity.
	measure 'Return Period Years' =
			AVERAGE ( dim_return_period[return_period_years] )
		formatString: #,0.0
		displayFolder: 07 Return periods

	/// Poisson rate for the selected severity and proximity.
	measure 'Events Per Year' =
			AVERAGE ( dim_return_period[events_per_year] )
		formatString: #,0.000
		displayFolder: 07 Return periods

	/// Chance of at least one such event in any given season.
	measure 'Season Probability' =
			AVERAGE ( dim_return_period[prob_at_least_one_per_year] )
		formatString: 0.0%
		displayFolder: 07 Return periods

	/// Plain-English card text. Handles the not-observed case rather than showing a blank.
	measure 'Return Period Statement' =
			VAR RP = [Return Period Years]
			VAR P = [Season Probability]
			RETURN
			    IF (
			        ISBLANK ( RP ),
			        "Not observed in the record",
			        "About once every " & FORMAT ( RP, "0.0" ) & " years, "
			            & FORMAT ( P, "0%" ) & " chance in any season"
			    )
		displayFolder: 07 Return periods

	/// Planning horizon figure. Easier to act on than a return period.
	measure 'Expected Events Next Decade' =
			[Events Per Year] * 10
		formatString: #,0.0
		displayFolder: 07 Return periods

	/// Events the return period rests on. Show it: a 5.7 year figure built on two observations should be read as indicative.
	measure 'Return Period Sample Size' =
			SUM ( dim_return_period[events] )
		formatString: #,0
		displayFolder: 07 Return periods

	/// Downtime by cyclone season. The season runs November to April, so a calendar year split would cut every season in half.
	measure 'Season Downtime Days' =
			CALCULATE (
			    [Total Downtime Days],
			    ALLEXCEPT ( fact_reliability_event, fact_reliability_event[season_label] )
			)
		formatString: #,0.0
		displayFolder: 08 Time

	/// Worst season on record.
	measure 'Worst Season Days' =
			MAXX (
			    VALUES ( fact_reliability_event[season_label] ),
			    [Season Downtime Days]
			)
		formatString: #,0.0
		displayFolder: 08 Time

	/// Which season was worst.
	measure 'Worst Season Label' =
			VAR Ranked =
			    ADDCOLUMNS (
			        VALUES ( fact_reliability_event[season_label] ),
			        "@days", [Season Downtime Days]
			    )
			VAR Best = TOPN ( 1, Ranked, [@days], DESC )
			RETURN
			    CONCATENATEX ( Best, fact_reliability_event[season_label] )
		displayFolder: 08 Time

	/// Twelve-month rolling availability. Smooths the seasonal sawtooth.
	measure 'Availability Rolling 12' =
			VAR LastMonth = MAX ( fact_reliability_monthly[month] )
			RETURN
			    CALCULATE (
			        [Availability Pct],
			        FILTER (
			            ALL ( fact_reliability_monthly ),
			            fact_reliability_monthly[month] <= LastMonth
			                && fact_reliability_monthly[month] > EDATE ( LastMonth, -12 )
			        )
			    )
		formatString: 0.00%
		displayFolder: 08 Time

	/// Rolling twelve-month downtime.
	measure 'Downtime Days Rolling 12' =
			VAR LastMonth = MAX ( fact_reliability_monthly[month] )
			RETURN
			    CALCULATE (
			        [Total Downtime Days],
			        FILTER (
			            ALL ( fact_reliability_event ),
			            fact_reliability_event[month] <= LastMonth
			                && fact_reliability_event[month] > EDATE ( LastMonth, -12 )
			        )
			    )
		formatString: #,0.0
		displayFolder: 08 Time

	/// Feed to conditional formatting via Format > Fx > Field value.
	measure 'Availability Colour' =
			VAR A = [Availability Pct]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( A ), "#888780",
			        A >= [Availability Target], "#1D9E75",
			        A >= 0.95, "#EF9F27",
			        "#E24B4A"
			    )
		displayFolder: 09 Formatting

	/// Category colour for charts. Pair with a shape or pattern so colour is not the only cue.
	measure 'Severity Colour' =
			VAR C = SELECTEDVALUE ( fact_reliability_event[category] )
			RETURN
			    SWITCH (
			        TRUE (),
			        C >= 4, "#A32D2D",
			        C = 3, "#BA7517",
			        C >= 1, "#378ADD",
			        "#888780"
			    )
		displayFolder: 09 Formatting

	/// Dynamic title so a screenshot always shows which scenario is set.
	measure 'Page Title' =
			VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category] )
			VAR Km = SELECTEDVALUE ( 'Scenario Distance'[Km] )
			RETURN
			    IF (
			        ISBLANK ( Cat ) || ISBLANK ( Km ),
			        "Select a scenario",
			        "Category " & Cat & " at " & Km & " km from Port Hedland"
			    )
		displayFolder: 09 Formatting

	/// Small footer text. Makes a silently applied filter obvious.
	measure 'Row Count Check' =
			"Months: " & DISTINCTCOUNT ( fact_reliability_monthly[month] )
			    & "   Events: " & [Event Count]
			    & "   Period: " & FORMAT ( MIN ( fact_reliability_monthly[month] ), "mmm yyyy" )
			    & " to " & FORMAT ( MAX ( fact_reliability_monthly[month] ), "mmm yyyy" )
		displayFolder: 09 Formatting

	/// Footer for every page. States the main limitation before anyone has to ask.
	measure 'Provenance Footer' =
			"Model calibrated on Port of Port Hedland, "
			    & FORMAT ( MIN ( fact_reliability_monthly[month] ), "yyyy" ) & " to "
			    & FORMAT ( MAX ( fact_reliability_monthly[month] ), "yyyy" )
			    & ", against Bureau of Meteorology cyclone records. "
			    & "Rio Tinto exports through Dampier and Cape Lambert, not Port Hedland."
		displayFolder: 09 Formatting

	/// Data quality issues identified.
	measure 'Defects Found' =
			COUNTROWS ( dim_data_quality )
		formatString: #,0
		displayFolder: 10 Data quality

	/// Issues corrected rather than accepted.
	measure 'Defects Fixed' =
			CALCULATE (
			    COUNTROWS ( dim_data_quality ),
			    dim_data_quality[status] = "Fixed"
			)
		formatString: #,0
		displayFolder: 10 Data quality

	/// Defects that would have changed the conclusions if missed.
	measure 'High Severity Defects' =
			CALCULATE (
			    COUNTROWS ( dim_data_quality ),
			    dim_data_quality[severity] = "High"
			)
		formatString: #,0
		displayFolder: 10 Data quality

	/// Records touched by a defect.
	measure 'Records Affected' =
			SUM ( dim_data_quality[records_affected] )
		formatString: #,0
		displayFolder: 10 Data quality

	/// Share of source PDFs parsed automatically.
	measure 'Parse Success Rate' =
			VAR Parsed =
			    CALCULATE (
			        COUNTROWS ( fact_reliability_monthly ),
			        NOT ISBLANK ( fact_reliability_monthly[total_throughput_mt] )
			    )
			VAR Total = COUNTROWS ( ALL ( fact_reliability_monthly ) )
			RETURN
			    DIVIDE ( Parsed, Total )
		formatString: 0.0%
		displayFolder: 10 Data quality

	/// Summary card text for page 5.
	measure 'Data Quality Statement' =
			FORMAT ( [Defects Found], "0" ) & " data quality issues found, "
			    & FORMAT ( [Defects Fixed], "0" ) & " corrected. "
			    & FORMAT ( [High Severity Defects], "0" )
			    & " would have changed the conclusions."
		displayFolder: 10 Data quality
