// ---- Nearest Analogue ----
{
    var name = @"Nearest Analogue";
    var expr = @"VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
VAR Km = SELECTEDVALUE ( 'Scenario Distance'[Km], 100 )
VAR Ranked =
    ADDCOLUMNS (
        ALL ( fact_reliability_event ),
        ""@dist"",
            ABS ( fact_reliability_event[category] - Cat ) * 100
                + ABS ( fact_reliability_event[km_to_port_hedland] - Km )
    )
VAR Best = TOPN ( 1, Ranked, [@dist], ASC )
RETURN
    CONCATENATEX ( Best, fact_reliability_event[event_label] )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"04 Scenario";
    m.Description = @"Closest historical event to the scenario. Operators trust a named past event more than a modelled number.";
}

// ---- Analogue Actual Loss Mt ----
{
    var name = @"Analogue Actual Loss Mt";
    var expr = @"VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
VAR Km = SELECTEDVALUE ( 'Scenario Distance'[Km], 100 )
VAR Ranked =
    ADDCOLUMNS (
        ALL ( fact_reliability_event ),
        ""@dist"",
            ABS ( fact_reliability_event[category] - Cat ) * 100
                + ABS ( fact_reliability_event[km_to_port_hedland] - Km )
    )
VAR Best = TOPN ( 1, Ranked, [@dist], ASC )
RETURN
    MAXX ( Best, fact_reliability_event[event_lost_mt] )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"04 Scenario";
    m.Description = @"What the nearest analogue actually cost. Sits beside the modelled estimate as a reality check.";
    m.FormatString = @"#,0.00";
}

// ---- Production Forgone AUD ----
{
    var name = @"Production Forgone AUD";
    var expr = @"VAR t = SELECTEDVALUE ( 'Lead Hours'[Hours] )
VAR PriceUSD = SELECTEDVALUE ( 'Iron Ore Price'[USD per tonne], 100 )
RETURN
    t * DIVIDE ( [Daily Capability Mt], 24 ) * 1000000 * PriceUSD
        / [AUD per USD]";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"Cost of stopping early. Derived from measured throughput.";
    m.FormatString = @"\$#,0";
}

// ---- Damage Probability ----
{
    var name = @"Damage Probability";
    var expr = @"VAR t = SELECTEDVALUE ( 'Lead Hours'[Hours] )
VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
VAR Mult = SELECTEDVALUE ( 'Curve Sensitivity'[Multiplier], 1 )
VAR k = DIVIDE ( 0.06, MAX ( Cat, 1 ) ) * Mult
VAR mid = 12 * Cat
RETURN
    DIVIDE ( 1, 1 + EXP ( k * ( t - mid ) ) )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"ASSUMPTION, not fitted. No operator publishes incident-level damage outcomes. Structured so a fitted curve can replace it.";
    m.FormatString = @"0.0%";
}

// ---- Expected Damage Cost AUD ----
{
    var name = @"Expected Damage Cost AUD";
    var expr = @"VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
VAR DamageCostPerCat = 50000000
RETURN
    [Damage Probability] * DamageCostPerCat * Cat";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"Damage cost per category is an assumption, stated on the page.";
    m.FormatString = @"\$#,0";
}

// ---- Total Expected Cost AUD ----
{
    var name = @"Total Expected Cost AUD";
    var expr = @"[Production Forgone AUD] + [Expected Damage Cost AUD]";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"The curve to minimise.";
    m.FormatString = @"\$#,0";
}

// ---- WHS Minimum Hours ----
{
    var name = @"WHS Minimum Hours";
    var expr = @"VAR Cat = SELECTEDVALUE ( 'Scenario Category'[Category], 3 )
RETURN
    IF ( Cat >= 3, 72, 48 )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"Minimum safe evacuation window. A hard constraint, not a cost. Below this the option does not exist at any price.";
    m.FormatString = @"#,0";
}

// ---- Cost Within WHS Limit ----
{
    var name = @"Cost Within WHS Limit";
    var expr = @"IF (
    SELECTEDVALUE ( 'Lead Hours'[Hours] ) >= [WHS Minimum Hours],
    [Total Expected Cost AUD]
)";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"Total cost, blanked inside the forbidden window.";
    m.FormatString = @"\$#,0";
}

// ---- Optimal Lead Hours ----
{
    var name = @"Optimal Lead Hours";
    var expr = @"VAR Costs =
    ADDCOLUMNS (
        FILTER ( ALL ( 'Lead Hours' ), 'Lead Hours'[Hours] >= [WHS Minimum Hours] ),
        ""@cost"", [Total Expected Cost AUD]
    )
VAR Best = TOPN ( 1, Costs, [@cost], ASC )
RETURN
    MAXX ( Best, 'Lead Hours'[Hours] )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"05 Shutdown timing";
    m.Description = @"Lowest-cost lead time inside the safe window.";
    m.FormatString = @"#,0";
}

// ---- Optimal Statement ----
{
    var name = @"Optimal Statement";
    var expr = @"""Recommended shutdown: "" & FORMAT ( [Optimal Lead Hours], ""0"" )
    & "" hours before landfall. WH&S minimum is ""
    & FORMAT ( [WHS Minimum Hours], ""0"" ) & "" hours.""";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
