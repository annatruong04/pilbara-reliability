    m.FormatString = @"#,0";
}

// ---- Season Downtime Days ----
{
    var name = @"Season Downtime Days";
    var expr = @"CALCULATE (
    [Total Downtime Days],
    ALLEXCEPT ( fact_reliability_event, fact_reliability_event[season_label] )
)";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"08 Time";
    m.Description = @"Downtime by cyclone season. The season runs November to April, so a calendar year split would cut every season in half.";
    m.FormatString = @"#,0.0";
}

// ---- Worst Season Days ----
{
    var name = @"Worst Season Days";
    var expr = @"MAXX (
    VALUES ( fact_reliability_event[season_label] ),
    [Season Downtime Days]
)";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"08 Time";
    m.Description = @"Worst season on record.";
    m.FormatString = @"#,0.0";
}

// ---- Worst Season Label ----
{
    var name = @"Worst Season Label";
    var expr = @"VAR Ranked =
    ADDCOLUMNS (
        VALUES ( fact_reliability_event[season_label] ),
        ""@days"", [Season Downtime Days]
    )
VAR Best = TOPN ( 1, Ranked, [@days], DESC )
RETURN
    CONCATENATEX ( Best, fact_reliability_event[season_label] )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"08 Time";
    m.Description = @"Which season was worst.";
}

// ---- Availability Rolling 12 ----
{
    var name = @"Availability Rolling 12";
    var expr = @"VAR LastMonth = MAX ( fact_reliability_monthly[month] )
RETURN
    CALCULATE (
        [Availability Pct],
        FILTER (
            ALL ( fact_reliability_monthly ),
            fact_reliability_monthly[month] <= LastMonth
                && fact_reliability_monthly[month] > EDATE ( LastMonth, -12 )
        )
    )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"08 Time";
    m.Description = @"Twelve-month rolling availability. Smooths the seasonal sawtooth.";
    m.FormatString = @"0.00%";
}

// ---- Downtime Days Rolling 12 ----
{
    var name = @"Downtime Days Rolling 12";
    var expr = @"VAR LastMonth = MAX ( fact_reliability_monthly[month] )
RETURN
    CALCULATE (
        [Total Downtime Days],
        FILTER (
            ALL ( fact_reliability_event ),
            fact_reliability_event[month] <= LastMonth
                && fact_reliability_event[month] > EDATE ( LastMonth, -12 )
        )
    )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"08 Time";
    m.Description = @"Rolling twelve-month downtime.";
    m.FormatString = @"#,0.0";
}

// ---- Availability Colour ----
{
    var name = @"Availability Colour";
    var expr = @"VAR A = [Availability Pct]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( A ), ""#888780"",
        A >= [Availability Target], ""#1D9E75"",
        A >= 0.95, ""#EF9F27"",
        ""#E24B4A""
    )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"09 Formatting";
    m.Description = @"Feed to conditional formatting via Format > Fx > Field value.";
}

// ---- Severity Colour ----
{
    var name = @"Severity Colour";
    var expr = @"VAR C = SELECTEDVALUE ( fact_reliability_event[category] )
RETURN
    SWITCH (
        TRUE (),
        C >= 4, ""#A32D2D"",
        C = 3, ""#BA7517"",
        C >= 1, ""#378ADD"",
        ""#888780""
    )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
