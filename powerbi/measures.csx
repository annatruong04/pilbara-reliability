    m.DisplayFolder = @"06 Validation";
    m.Description = @"Capability minus fitted. Not capability minus actual: the gap between actual and fitted is ordinary model residual.";
    m.FormatString = @"#,0.0";
}

// ---- Residual Mt ----
{
    var name = @"Residual Mt";
    var expr = @"[Actual Mt] - [Fitted Mt]";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"06 Validation";
    m.Description = @"Model error, unrelated to cyclones.";
    m.FormatString = @"#,0.0";
}

// ---- Mean Absolute Error Mt ----
{
    var name = @"Mean Absolute Error Mt";
    var expr = @"AVERAGEX (
    fact_reliability_monthly,
    ABS (
        fact_reliability_monthly[total_throughput_mt]
            - fact_reliability_monthly[fitted_mt]
    )
)";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"06 Validation";
    m.Description = @"Average absolute model error.";
    m.FormatString = @"#,0.00";
}

// ---- Implied Closure Days ----
{
    var name = @"Implied Closure Days";
    var expr = @"DIVIDE ( [Total Lost Mt], [Daily Capability Mt] )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"06 Validation";
    m.Description = @"Loss converted to days. The model never sees closure durations, so agreement with observed practice is external corroboration.";
    m.FormatString = @"#,0.0";
}

