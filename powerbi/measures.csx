// ---- Modelled Loss Mt ----
{
    var name = @"Modelled Loss Mt";
    var expr = @"SUM ( fact_reliability_monthly[lost_mt] )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
