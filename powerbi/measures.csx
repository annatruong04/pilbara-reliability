// ---- Parse Success Rate ----
{
    var name = @"Parse Success Rate";
    var expr = @"VAR Parsed =
    CALCULATE (
        COUNTROWS ( fact_reliability_monthly ),
        NOT ISBLANK ( fact_reliability_monthly[total_throughput_mt] )
    )
VAR Total = COUNTROWS ( ALL ( fact_reliability_monthly ) )
RETURN
    DIVIDE ( Parsed, Total )";
    var m = tbl.Measures.FirstOrDefault(x => x.Name == name);
    if (m == null) { m = tbl.AddMeasure(name); created++; }
    else { updated++; }
    m.Expression = expr;
    m.DisplayFolder = @"10 Data quality";
    m.Description = @"Share of source PDFs parsed automatically.";
    m.FormatString = @"0.0%";
}

